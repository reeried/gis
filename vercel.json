{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/files/upload.js": {
      "maxDuration": 60
    },
    "api/files/upload-from-url.js": {
      "maxDuration": 60
    }
  }
}

